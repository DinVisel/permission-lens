{
  "name": "@permissionlens/onchain",
  "version": "0.0.0",
  "description": "Optional on-chain enrichment for PermissionLens decode results (Phase 2).",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DinVisel/permission-lens.git",
    "directory": "packages/onchain"
  },
  "homepage": "https://github.com/DinVisel/permission-lens/tree/main/packages/onchain#readme",
  "bugs": "https://github.com/DinVisel/permission-lens/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@permissionlens/core": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.21.0",
    "vitest": "^2.1.8"
  }
}
