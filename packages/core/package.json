    "viem": "^2.21.0"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.21.0",
    "vitest": "^2.1.8"
  }
}
